# Copia este archivo como .env y completa los valores

DATABASE_URL=sqlite:///./minutas.db
# En Vercel: la URL de Postgres que da Neon (postgres://... también funciona)
# DATABASE_URL=postgresql://usuario:clave@servidor/minutas?sslmode=require

# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=seguridata.com

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# IA que redacta las minutas: anthropic (Claude) u openai (ChatGPT). Vacío = Anthropic si hay
# ANTHROPIC_API_KEY; si no, OpenAI si hay OPENAI_API_KEY.
AI_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Llave de platform.openai.com > API keys (no es la suscripción de ChatGPT Plus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Correos (separados por coma) que pueden ver el consumo de IA de toda la empresa
ADMIN_EMAILS=

# Monday: cada persona conecta su cuenta desde su perfil pegando su token personal (se guarda cifrado)
# y elige su tablero. false apaga la integración para todos.
MONDAY_ENABLED=true
# Opcional: app OAuth de la empresa para conectar con un botón en vez de pegar el token. Se registra en
# Monday > Desarrolladores > Crear app > OAuth, con la URL de redirección
# {BACKEND_URL}/auth/monday/callback y los permisos me:read, boards:read, boards:write, users:read y notifications:write.
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
